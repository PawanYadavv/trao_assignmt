# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string. A free MongoDB Atlas M0 cluster is enough.
# Required by the web app (auth + kit persistence). NOT required by the
# `npm run evaluate` batch command, which never touches the database.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Database name used inside that cluster.
MONGODB_DB_NAME=prepwise

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible chat-completions API)
# ---------------------------------------------------------------------------
# Any provider exposing POST /chat/completions works. Groq is the documented
# default because its free tier is genuine (no card) and fast.
#   Groq      https://api.groq.com/openai/v1/chat/completions   llama-3.3-70b-versatile
#   OpenRouter https://openrouter.ai/api/v1/chat/completions    meta-llama/llama-3.3-70b-instruct:free
#   Together  https://api.together.xyz/v1/chat/completions      meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
#
# If LLM_API_KEY is empty the pipeline still runs end to end on its
# deterministic extractor and question templates, and every kit records
# "llm": false in kit.source.generation so the degradation is visible.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Client-side throttle, tuned for a free tier that limits tokens per minute as
# well as requests per minute. Optional - these are the defaults.
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=25
LLM_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Set to "true" to allow crawling private/loopback addresses. The batch harness
# may serve company sites from localhost, so this defaults to true outside
# production and must stay false on a public deployment.
ALLOW_PRIVATE_CRAWL_TARGETS=false
